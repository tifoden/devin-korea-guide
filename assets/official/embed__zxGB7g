</style><style id="tally-custom-css">/* Devin for Startups (tally.so/r/zxGB7g): match devin.ai/startups latest design system. */
@font-face {
  font-family: "NB International Pro";
  src: url("https://devin.ai/assets/fonts/NBInternationalPro-Regular.woff2") format("woff2");
  font-weight: 400 500;
  font-style: normal;
  font-display: swap;
}

:root {
  --dt-text: rgb(25, 25, 25);
  --dt-text-secondary: rgba(25, 25, 25, 0.56);
  --dt-text-disabled: rgba(25, 25, 25, 0.4);
  --dt-tint-soft: rgba(0, 0, 0, 0.06);
  --dt-primary: rgb(49, 124, 255);
  --dt-button: rgb(0, 0, 0);
  --dt-font: "NB International Pro", system-ui, sans-serif;
  --tally-builder-font: var(--dt-font);
  --tally-builder-text: var(--dt-text);
}

.tally-page,
.tally-page * {
  font-family: var(--dt-font) !important;
}

.tally-page {
  color: var(--dt-text) !important;
}

/* Labels */
.tally-block-title,
.tally-block-title * {
  color: var(--dt-text) !important;
  font-size: 16px !important;
  font-weight: 400 !important;
  line-height: 1.4 !important;
}

.tally-block-title h3 {
  font-weight: 400 !important;
}

.tally-block-title > div > div {
  padding: 20px 0 12px !important;
}

.tally-block-form-title + .tally-block-title > div > div,
.tally-page form > div > .tally-block-title:first-of-type > div > div {
  padding-top: 0 !important;
}

.tally-block-text {
  margin: -4px 0 12px !important;
}

.tally-required-indicator {
  display: none !important;
}

/* Helper text (e.g. under Email) */
.tally-block-text,
.tally-block-text * {
  color: var(--dt-text-secondary) !important;
  font-size: 14px !important;
  line-height: 1.4 !important;
}

/* Inputs, dropdown and date fields */
.tally-page input,
.tally-page textarea {
  height: auto !important;
  min-height: 43px !important;
  padding: 10px 16px !important;
  border: 0 !important;
  border-radius: 0 !important;
  background-color: var(--dt-tint-soft) !important;
  box-shadow: none !important;
  color: var(--dt-text) !important;
  font-size: 16px !important;
  line-height: 1.4 !important;
}

.tally-page input::placeholder,
.tally-page textarea::placeholder {
  color: var(--dt-text-disabled) !important;
}

.tally-page input:focus,
.tally-page input:focus-visible,
.tally-page textarea:focus,
.tally-page textarea:focus-visible {
  outline: 2px solid var(--dt-primary) !important;
  outline-offset: -2px !important;
  box-shadow: none !important;
}

.tally-page svg {
  color: var(--dt-text-secondary) !important;
}

/* Dropdown */
.tally-block-dropdown *::before,
.tally-block-dropdown *::after {
  background: none !important;
}

.tally-context-menu {
  border: 0 !important;
  border-radius: 0 !important;
  background-color: rgb(252, 252, 252) !important;
  box-shadow: 0 0 0 1px var(--dt-tint-soft), 0 8px 24px rgba(0, 0, 0, 0.08) !important;
}

.tally-context-menu > div,
[role="listbox"] {
  border-radius: 0 !important;
  background-color: rgb(252, 252, 252) !important;
}

[role="listbox"] [role="option"],
[role="listbox"] [role="option"] * {
  border-radius: 0 !important;
  color: var(--dt-text) !important;
  font-family: var(--dt-font) !important;
}

