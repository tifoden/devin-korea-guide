---
layout: layouts/base.njk
bodyClass: page-article
---
{%- set headings = content | toc -%}
<article class="article" aria-labelledby="article-title">
  <header class="article__header">
    <div class="page-container">
      <nav class="breadcrumb" aria-label="현재 위치">
        <ol>
          <li><a href="/">홈</a></li>
          {%- if parentUrl %}
          <li><a href="{{ parentUrl }}">{{ parentLabel }}</a></li>
          {%- endif %}
          <li><span aria-current="page">{{ crumb or (series + " " + seriesNumber) }}</span></li>
        </ol>
      </nav>
      <h1 id="article-title" class="t-h2 article__title">{{ title }}</h1>
      <p class="article__lead">{{ description }}</p>
      <dl class="meta-list meta-list--row">
        <div><dt>읽는 시간</dt><dd>약 {{ content | readingMinutes }}분</dd></div>
      </dl>
    </div>
  </header>

  {%- if headings.length %}
  <nav class="subnav" aria-label="이 글의 섹션 바로가기">
    <div class="page-container">
      <ol class="subnav__list">
        {%- for h in headings %}
        <li><a class="subnav__link" href="#{{ h.id }}"><span class="subnav__num" aria-hidden="true">{{ "0" if loop.index < 10 else "" }}{{ loop.index }}</span>{{ h.text }}</a></li>
        {%- endfor %}
      </ol>
    </div>
  </nav>
  {%- endif %}

  <div class="band">
    <div class="page-container">
      <div class="frame article__layout">
        {%- if headings.length %}
        <nav class="toc" aria-labelledby="toc-title">
          <details class="toc__details" open>
            <summary id="toc-title" class="mono-label toc__title">이 글의 차례</summary>
            <ol class="toc__list">
              {%- for h in headings %}
              <li><a href="#{{ h.id }}">{{ h.text }}</a></li>
              {%- endfor %}
            </ol>
          </details>
        </nav>
        {%- endif %}

        <div class="prose">
          {{ content | safe }}


          <p class="article__back"><a class="btn btn--secondary" href="/"><span aria-hidden="true">←</span> 홈으로</a></p>
        </div>
      </div>
    </div>
  </div>
</article>
