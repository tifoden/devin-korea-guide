---
layout: layouts/base.njk
bodyClass: page-replica
extraCss: ["/assets/official/official.css"]
---
<div class="{{ replicaClass or 'official light theme-light font-body antialiased' }}" lang="ko">
{% if replica %}{% replica replica %}{% else %}{{ content | safe }}{% endif %}
</div>
{%- if availability %}
<section class="product-note" aria-label="이용 조건">
  <div class="page-container product-note__inner"><p>{{ availability | safe }}</p></div>
</section>
{%- endif %}
