<!doctype html>
<html lang="{{ site.lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title and page.url != "/" %}{{ title }} — {% endif %}{{ site.title }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <meta name="robots" content="noindex, nofollow">
  <meta name="color-scheme" content="light">
  <link rel="stylesheet" href="/assets/fonts/pretendard/pretendardvariable-dynamic-subset.css">
  <link rel="stylesheet" href="/assets/css/site.css">
  {%- for css in extraCss %}
  <link rel="stylesheet" href="{{ css }}">
  {%- endfor %}
  <script>document.documentElement.classList.add("js")</script>
  <script src="/assets/js/nav.js" defer></script>
  <script src="/assets/js/motion.js" defer></script>
</head>
<body class="{{ bodyClass }}">
  <a class="skip-link" href="#main">본문으로 건너뛰기</a>
  <header class="site-header" data-header>
    <div class="page-container site-header__inner">
      <a class="wordmark" href="/">
        <img class="wordmark__logo" src="/assets/brand/devin-korea-logo.svg" alt="Devin 한국어 가이드" width="773" height="120">
      </a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-menu">
        <span class="menu-toggle__bars" aria-hidden="true"></span><span class="visually-hidden">메뉴</span>
      </button>
      <div class="site-menu" id="site-menu">
        <nav class="site-nav" aria-label="주 메뉴">
          <ul>
            {%- for item in nav %}
            {%- set current = (page.url == item.url) or (item.match and (page.url | startsWith(item.match))) %}
            {%- if item.menu %}
          <li class="nav-item">
            <a class="nav-link nav-fallback" href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a>
            <button class="nav-link nav-trigger{% if current %} is-current{% endif %}"{% if current %} data-current{% endif %} type="button" aria-expanded="false" aria-controls="{{ item.id }}">{{ item.label }}{% if current %}<span class="visually-hidden"> (현재 섹션)</span>{% endif %}<span class="nav-trigger__chevron" aria-hidden="true"></span></button>
            <div class="nav-panel" id="{{ item.id }}">
              {%- for group in item.menu %}
              <div class="nav-panel__group">
                <p class="nav-panel__heading" id="{{ item.id }}-g{{ loop.index }}">{{ group.heading }}</p>
                <ul aria-labelledby="{{ item.id }}-g{{ loop.index }}">
                  {%- for link in group.items %}
                  <li><a class="nav-panel__link" href="{{ link.url }}"{% if page.url == link.url %} aria-current="page"{% endif %}><span class="nav-panel__label"{% if link.lang != "ko" %} lang="en"{% endif %}>{{ link.label }}</span>{% if link.tag %} <span class="badge badge--neutral">{{ link.tag }}</span>{% endif %}<span class="nav-panel__desc">{{ link.desc }}</span></a></li>
                  {%- endfor %}
                </ul>
              </div>
              {%- endfor %}
              <a class="nav-panel__overview" href="{{ item.overview.url }}"{% if page.url == item.overview.url %} aria-current="page"{% endif %}>{{ item.overview.label }} <span aria-hidden="true">→</span></a>
            </div>
          </li>
          {%- else %}
          <li><a class="nav-link" href="{{ item.url }}"{% if item.section %} data-section="{{ item.section }}"{% endif %}{% if current %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
          {%- endif %}
            {%- endfor %}
          </ul>
        </nav>
        <div class="site-header__actions">
          <a class="header-pill header-pill--outline" href="{{ site.pricingUrl }}">요금제</a>
          <div class="nav-item header-cta">
            <button class="header-pill header-pill--solid nav-trigger" type="button" aria-expanded="false" aria-controls="cta-menu">도입 상담하기<span class="nav-trigger__chevron" aria-hidden="true"></span></button>
            <div class="nav-panel nav-panel--cta" id="cta-menu">
              <ul>
                <li><a class="nav-panel__link" href="{{ site.ambassadorMeetingUrl }}"><span class="nav-panel__label">한국 앰버서더와 미팅</span><span class="nav-panel__desc">도입과 활용을 한국어로 상담합니다</span></a></li>
                <li><a class="nav-panel__link" href="{{ site.demoUrl }}" target="_blank" rel="noopener"><span class="nav-panel__label"><span lang="en">Devin</span> 데모 받기</span><span class="nav-panel__desc">devin.ai에서 데모를 신청합니다 <span aria-hidden="true">↗</span><span class="visually-hidden">(새 창)</span></span></a></li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </header>
  <div class="nav-scrim" aria-hidden="true"></div>

  <main id="main" tabindex="-1">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="page-container">
      <div class="site-footer__grid">
        <p class="site-footer__brand"><a href="/"><img class="site-footer__logo" src="/assets/brand/devin-korea-logo.svg" alt="Devin 한국어 가이드" width="773" height="120"></a></p>
        <nav class="site-footer__col" aria-labelledby="footer-product">
          <h2 id="footer-product" class="site-footer__heading">제품</h2>
          <ul>
            <li><a href="/features/cloud/">Devin Cloud</a></li>
            <li><a href="/features/desktop/">Devin Desktop</a></li>
            <li><a href="/features/cli/">Devin CLI</a></li>
            <li><a href="/features/review/">Devin Review</a></li>
            <li><a href="/features/security/">Devin Security</a></li>
            <li><a href="/features/oncall/">Devin Oncall</a></li>
          </ul>
        </nav>
        <nav class="site-footer__col" aria-labelledby="footer-models">
          <h2 id="footer-models" class="site-footer__heading">모델</h2>
          <ul>
            <li><a href="/models/fusion/">Fusion</a></li>
            <li><a href="/models/third-party/">타사 모델</a></li>
            <li><a href="/models/">모델 개요</a></li>
          </ul>
        </nav>
        <nav class="site-footer__col" aria-labelledby="footer-start">
          <h2 id="footer-start" class="site-footer__heading">시작하기</h2>
          <ul>
            {%- for guide in collections.guides %}
            <li><a href="{{ guide.url }}">{{ guide.data.navTitle or guide.data.title }}</a></li>
            {%- endfor %}
            <li><a href="/startups/">스타트업 프로그램</a></li>
            <li><a href="{{ site.officialDocs }}">공식 문서 <span aria-hidden="true">↗</span></a></li>
          </ul>
        </nav>
      </div>
      <p class="site-footer__legal mono-label">Devin은 Cognition의 제품입니다 · 글꼴 Pretendard(<a href="/assets/fonts/pretendard/LICENSE.txt">OFL</a>) · Geist Mono(<a href="/assets/fonts/geist-mono/LICENSE.txt">OFL</a>)</p>
    </div>
  </footer>
</body>
</html>
