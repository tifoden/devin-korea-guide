---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
layout: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for p in collections.all | sort(false, false, "url") %}
{%- if p.url and p.url != "/overview/" and p.url != "/use-cases/" and p.url != "/sitemap.xml" and p.url != "/robots.txt" %}
  <url>
    <loc>{{ site.url }}{{ p.url }}</loc>
  </url>
{%- endif %}
{%- endfor %}
</urlset>
